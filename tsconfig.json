{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "components/**/*.tsx",
    "components/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
