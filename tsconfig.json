{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "components/**/*.tsx",
    "components/**/*.ts"
  ],
  "exclude": [
    "components/core/index.ts"
  ]
}
