{
  "name": "tedx-amsterdam-design-system",
  "version": "1.2.1",
  "description": "TEDxAmsterdam design system: dark-first React components and CSS design tokens",
  "license": "MIT",
  "author": "Julian Aijal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianaijal/tedx-amsterdam-design-system.git"
  },
  "homepage": "https://github.com/julianaijal/tedx-amsterdam-design-system#readme",
  "bugs": {
    "url": "https://github.com/julianaijal/tedx-amsterdam-design-system/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "design-tokens",
    "css",
    "accessibility",
    "tedx"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/core/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "tokens",
    "readme.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "lint": "oxlint components scripts tests",
    "build": "node scripts/build-bundle.js",
    "build:dist": "node scripts/build-dist.js && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:website": "node scripts/build-website.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build:dist"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.25.12",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "oxlint": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^9.1.20",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  }
}
